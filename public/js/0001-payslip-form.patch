+      '.employer { font-size:10pt;font-weight:600;color:#333;margin-bottom:1mm; }',
+      '.notes { font-size:8.5pt;margin:3mm 0 2mm; }',
+      '.notes b { font-size:9pt; }',
+      '.notes ol { margin:1mm 0 0;padding-inline-start:5mm; }',
+      '.notes li { margin-bottom:0.6mm; }',
