+  function _print() {
+    if (!activeEmployees().length) {
+      toast('⚠️ ' + tt('אין עובדים להדפסה','ไม่มีข้อมูล','لا يوجد بيانات'));
+      return;
+    }
+    // Open synchronously inside the click handler or the popup blocker eats it.
+    var w = window.open('about:blank', '_blank', 'width=1000,height=720');
+    if (!w || w.closed || typeof w.closed === 'undefined') {
+      toast('❌ ' + tt('חוסם חלונות קופצים פעיל — אפשר חלונות לאתר',
+                      'Popup blocked','مانع النوافذ المنبثقة نشط'));
+      return;
+    }
+    w.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"></head><body style="font-family:sans-serif;padding:40px;text-align:center">📄</body></html>');
+    var html = buildPrintHTML();
+    w.document.open();
+    w.document.write(html);
+    w.document.close();
+
+    toast('📄 ' + tt('בחר "שמור כ-PDF" בחלון ההדפסה','เลือก Save as PDF','اختر حفظ كـ PDF'));
+
+    var trigger = function() {
+      try {
+        w.focus();
+        var fontsReady = (w.document.fonts && w.document.fonts.ready) ? w.document.fonts.ready : Promise.resolve();
+        fontsReady.then(function() {
+          setTimeout(function() {
+            try { w.print(); } catch (e) { console.warn('print() failed:', e); }
+            var closed = false;
+            w.onafterprint = function() {
+              if (!closed) { closed = true; setTimeout(function() { try { w.close(); } catch (e) {} }, 200); }
+            };
+            setTimeout(function() { if (!closed) { try { w.close(); } catch (e) {} } }, 300000);
+          }, 200);
+        });
+      } catch (e) { console.error('[PayslipForm print]', e); }
+    };
+    if (w.document.readyState === 'complete') trigger();
+    else w.onload = trigger;
+  }
+
+  // ── output: CSV (for the accountant's software) ──
+  function _exportCSV() {
+    var lines = [];
+    lines.push(['שם העובד'].concat(COLS.map(function(c) { return c.he; })).concat(['הערות']).join(','));
+    activeEmployees().forEach(function(emp) {
+      var r = row(emp.id);
+      var cells = ['"' + String(emp.name).replace(/"/g, '""') + '"'];
+      COLS.forEach(function(c) { cells.push(fmt(r[c.k], c.dec)); });
+      cells.push('"' + String(r.note || '').replace(/"/g, '""') + '"');
+      lines.push(cells.join(','));
+    });
+    var t = totals();
+    var tot = ['"סה""כ"'];
+    COLS.forEach(function(c) { tot.push(c.sum ? fmt(t[c.k], c.dec) : ''); });
+    tot.push('');
+    lines.push(tot.join(','));
+
+    var blob = new Blob(['\ufeff' + lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
+    var a = document.createElement('a');
+    a.href = URL.createObjectURL(blob);
+    a.download = 'salary-hours-' + monthKey() + '.csv';
+    document.body.appendChild(a);
+    a.click();
+    setTimeout(function() { document.body.removeChild(a); URL.revokeObjectURL(a.href); }, 100);
+    toast('⤓ CSV');
+  }
+
+  // Warm the cache so the first open paints with data rather than empty.
+  if (typeof DB !== 'undefined') {
+    setTimeout(function() { load(); }, 1400);
+  }
+
+  return {
