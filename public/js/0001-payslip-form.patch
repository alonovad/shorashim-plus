+    _delEmployee: _delEmployee,
+    _saveRoster: _saveRoster,
+    _syncUsers: _syncUsers,
+    _saveSettings: _saveSettings,
+    _print: _print,
+    _exportCSV: _exportCSV
+  };
+})();
