+    toast('👥 ' + n + ' ' + tt('נוספו','เพิ่มแล้ว','أُضيفوا'));
+  }
+
+  function _saveSettings() {
+    var eEl = document.getElementById('psEmployer');
+    var nEl = document.getElementById('psNotes');
+    if (eEl) _data().settings.employer = eEl.value.trim();
+    if (nEl) {
+      var lines = nEl.value.split('\n').map(function(l) { return l.trim(); }).filter(Boolean);
+      _data().settings.notes = lines.length ? lines : DEFAULT_NOTES.slice();
+    }
+    save();
+    render();
+    toast('✅ ' + tt('נשמר','บันทึกแล้ว','تم الحفظ'));
+  }
+
+  // ── output: print / PDF ──
+  // Native print-to-PDF, same approach export.js settled on after html2pdf
+  // kept producing blank RTL pages. Real text, real Hebrew, no canvas.
+  function buildPrintHTML() {
+    var s = _data().settings;
+    var emps = activeEmployees();
+    var t = totals();
+
+    var head = '<th class="nm">שם העובד</th>';
+    COLS.forEach(function(c) { head += '<th>' + esc(c.he) + '</th>'; });
+    head += '<th class="nt">הערות</th>';
+
+    var body = '';
+    emps.forEach(function(emp) {
+      var r = row(emp.id);
+      body += '<tr><td class="nm">' + esc(emp.name) + '</td>';
+      COLS.forEach(function(c) { body += '<td>' + esc(fmt(r[c.k], c.dec)) + '</td>'; });
+      body += '<td class="nt">' + esc(r.note) + '</td></tr>';
+    });
+
+    // A few blank rows so the accountant can add a late hire by hand.
+    for (var b = 0; b < 3; b++) {
+      body += '<tr class="blank"><td class="nm">&nbsp;</td>';
+      COLS.forEach(function() { body += '<td>&nbsp;</td>'; });
+      body += '<td class="nt">&nbsp;</td></tr>';
