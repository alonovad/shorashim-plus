+++ b/public/js/payslip-form.js
@@ -0,0 +1,997 @@
+// ── טופס שעות חודשי לרו"ח (PAYSLIP HOURS FORM) ──
+// The paper form the accountant needs every month: one row per employee with
+// ימי עבודה / שעות רגילות / 125% / 150% / שכר לשעה / חופש / מחלה / הבראה /
+// חג / נסיעות / מפרעה / הערות, printed A4 landscape with the standard
+// employer notes and signature line.
+//
+// This is a DATA ENTRY + OUTPUT screen, not a second payroll engine:
+//   • The roster and the per-employee defaults live here.
+//   • "מילוי מהשעון" pulls the month from `timeclock` + `attendance-events`
+//     and tiers it with the SAME contract rules payroll.js/hours-report.js
+//     use — so the form can never disagree with דוח שעות רוחבי.
+//   • Every cell stays hand-editable. A cell you type into is flagged in
+//     row.manual and a later auto-fill will NOT overwrite it.
+//
+// Storage: one admin-owned document, appData/shorashim-payslip-form, saved
+// through DB.save like every other config blob. One entry to whitelist in
+// firestore.rules. Employees who have no app account are supported — the
+// roster is standalone and only OPTIONALLY linked to a username.
+//
+// ⚠ This form reports HOURS AND AMOUNTS AS ENTERED. It is not a payslip and
+// computes no tax, pension, national insurance or sick-pay accrual. The
+// ₪ column on screen is an estimate for sanity-checking only; payroll of
+// record stays with the accountant. Same disclaimer as payroll.js.
+
+var PayslipForm = (function() {
+  'use strict';
+
+  var KEY = 'shorashim-payslip-form';
+  var MAX_MONTHS = 48;   // keep 4 years, prune older so the doc can't grow forever
+
+  function tt(he, th, ar) {
+    var lang = (typeof currentLang !== 'undefined') ? currentLang : 'he';
+    if (lang === 'th') return th || he;
+    if (lang === 'ar') return ar || he;
+    return he;
+  }
+
+  var MONTHS = ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
+
+  // Column model — drives the screen table, the print table and the CSV, so
+  // the three can never drift apart.
+  var COLS = [
+    { k: 'days',     he: 'ימי עבודה',   unit: 'ימים', dec: 0, sum: true },
+    { k: 'reg',      he: 'שעות רגילות', unit: 'שעות', dec: 2, sum: true },
+    { k: 't125',     he: '125%',        unit: 'שעות', dec: 2, sum: true },
+    { k: 't150',     he: '150%',        unit: 'שעות', dec: 2, sum: true },
+    { k: 'rate',     he: 'שכר לשעה',    unit: '₪',    dec: 2, sum: false },
+    { k: 'vacation', he: 'חופש',        unit: 'ימים', dec: 2, sum: true },
+    { k: 'sick',     he: 'מחלה',        unit: 'ימים', dec: 2, sum: true },
+    { k: 'recup',    he: 'הבראה',       unit: 'ימים', dec: 2, sum: true },
+    { k: 'holiday',  he: 'חג',          unit: 'ימים', dec: 2, sum: true },
+    { k: 'travel',   he: 'נסיעות',      unit: '₪',    dec: 2, sum: true },
+    { k: 'advance',  he: 'מפרעה',       unit: '₪',    dec: 2, sum: true }
+  ];
+
+  // The employer notes printed on the form. Editable in הגדרות so a change in
+  // the law doesn't need a code deploy.
+  var DEFAULT_NOTES = [
+    'יש למלא טופס 101 לכל עובד בתחילת שנת המס.',
+    'יש למלא את כל הנתונים עד לא יאוחר מ-5 לכל חודש.',
+    'יש לשלם את המשכורת בצירוף התלוש לכל עובד לא יאוחר מ-9 לחודש.',
+    'יש חובה להפריש פנסיה לכל עובד.',
+    'יש חובה על המעסיק לתת הודעה בכתב לעובד בגין תנאי עבודתו.',
+    'יש להקפיד על מילוי הוראות תיקון חוק הגנת השכר החל מפברואר 2009.'
+  ];
+
+  // ── state ──
+  var data = null;
+  var state = {
+    year: 0, month: 0,
+    view: 'sheet',        // sheet | roster | settings
+    loading: false,
+    autofilling: false
+  };
+
+  // ── small helpers ──
+  function pad(n) { return (n < 10 ? '0' : '') + n; }
+
+  function esc(v) {
+    return String(v == null ? '' : v)
+      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+      .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+  }
+
+  function toast(m) { if (typeof showToast === 'function') showToast(m); }
+
+  // Accepts "8.5", "8:30", "8,5" and plain numbers. Hours are stored as a
+  // decimal because that is what a payroll clerk keys into their software;
+  // HH:MM is only an input convenience.
+  function parseNum(v) {
+    if (v == null) return 0;
+    var s = String(v).trim().replace(',', '.');
+    if (!s) return 0;
+    if (s.indexOf(':') !== -1) {
+      var p = s.split(':');
+      var h = parseFloat(p[0]) || 0;
+      var m = parseFloat(p[1]) || 0;
+      return h + (h < 0 ? -m : m) / 60;
+    }
+    var n = parseFloat(s);
+    return isNaN(n) ? 0 : n;
+  }
+
+  function fmt(n, dec) {
+    n = Number(n) || 0;
+    if (!n) return '';
+    return n.toFixed(dec == null ? 2 : dec);
+  }
+
+  function newId() {
+    return 'e' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
+  }
+
+  function monthKey() { return state.year + '-' + pad(state.month + 1); }
+  function monthLabel() { return MONTHS[state.month] + ' ' + state.year; }
+
+  function isAdminRole() { return window.currentUser && window.currentUser.role === 'admin'; }
+
+  // ── data model ──
+  function blank() {
+    return {
+      employees: [],
+      months: {},
+      settings: { employer: '', notes: DEFAULT_NOTES.slice() }
+    };
+  }
+
+  function blankRow() {
+    return {
+      days: 0, reg: 0, t125: 0, t150: 0, rate: 0,
+      vacation: 0, sick: 0, recup: 0, holiday: 0,
+      travel: 0, advance: 0, note: '', manual: {}
+    };
+  }
+
+  // Backward compatible: every field defaults, so a document written by an
+  // older version (or a half-filled month) never crashes a render.
+  function normalise(raw) {
+    var d = raw && typeof raw === 'object' ? raw : {};
+    var out = blank();
+
+    if (Array.isArray(d.employees)) {
+      out.employees = d.employees.filter(function(e) { return e && e.name; }).map(function(e) {
+        return {
+          id: e.id || newId(),
+          name: String(e.name),
+          username: e.username || '',
+          hourlyRate: Number(e.hourlyRate) || 0,
+          travelDefault: Number(e.travelDefault) || 0,
+          active: e.active !== false,
+          note: e.note || ''
+        };
+      });
+    }
+
+    if (d.months && typeof d.months === 'object') {
+      Object.keys(d.months).forEach(function(mk) {
+        var m = d.months[mk] || {};
+        var rows = {};
+        if (m.rows && typeof m.rows === 'object') {
+          Object.keys(m.rows).forEach(function(rid) {
+            var r = m.rows[rid] || {};
+            var row = blankRow();
+            COLS.forEach(function(c) { row[c.k] = Number(r[c.k]) || 0; });
+            row.note = r.note || '';
+            row.manual = (r.manual && typeof r.manual === 'object') ? r.manual : {};
+            rows[rid] = row;
+          });
+        }
+        out.months[mk] = { rows: rows, updatedAt: m.updatedAt || 0 };
+      });
+    }
+
+    if (d.settings && typeof d.settings === 'object') {
+      out.settings.employer = d.settings.employer || '';
+      if (Array.isArray(d.settings.notes) && d.settings.notes.length) {
+        out.settings.notes = d.settings.notes.slice();
+      }
+    }
+    return out;
+  }
+
+  function _data() {
+    if (!data) {
+      var local = null;
+      try { local = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { local = null; }
+      data = normalise(local);
+    }
+    return data;
+  }
+
+  function load() {
+    return new Promise(function(resolve) {
+      if (typeof DB === 'undefined') { resolve(_data()); return; }
+      DB.loadAsync(KEY).then(function(d) {
+        data = normalise(d);
+        resolve(data);
+      })['catch'](function() { resolve(_data()); });
+    });
+  }
+
+  function prune() {
+    var keys = Object.keys(_data().months).sort();
+    while (keys.length > MAX_MONTHS) {
+      delete _data().months[keys.shift()];
+    }
+  }
+
+  function save() {
+    prune();
+    if (typeof DB !== 'undefined') DB.save(KEY, _data());
+    if (typeof Audit !== 'undefined' && Audit && typeof Audit.log === 'function') {
+      try { Audit.log('edit', 'payslip-form', KEY, { month: monthKey() }); } catch (e) {}
+    }
+  }
+
+  function month(mk) {
+    var d = _data();
+    if (!d.months[mk]) d.months[mk] = { rows: {}, updatedAt: 0 };
+    return d.months[mk];
+  }
+
+  function row(empId) {
+    var m = month(monthKey());
+    if (!m.rows[empId]) {
+      var r = blankRow();
+      // A new row starts from the employee's standing defaults, so the common
+      // case (same rate, same travel allowance every month) is zero typing.
+      var emp = employeeById(empId);
+      if (emp) {
+        r.rate = emp.hourlyRate || 0;
+        r.travel = emp.travelDefault || 0;
+      }
+      m.rows[empId] = r;
+    }
+    return m.rows[empId];
+  }
+
+  function employeeById(id) {
+    var list = _data().employees;
+    for (var i = 0; i < list.length; i++) if (list[i].id === id) return list[i];
+    return null;
+  }
+
+  function activeEmployees() {
+    return _data().employees.filter(function(e) { return e.active !== false; });
+  }
+
+  // ── roster seeding ──
+  // First open on a fresh install: pull the app's own user list so the admin
+  // isn't retyping names that already exist. Workers without app accounts get
+  // added by hand in the עובדים tab.
+  function seedFromUsers() {
+    var users = (typeof window.users !== 'undefined' && window.users) ? window.users : {};
+    var have = {};
+    _data().employees.forEach(function(e) { if (e.username) have[e.username] = true; });
+
+    var added = 0;
+    Object.keys(users).forEach(function(u) {
+      var usr = users[u];
+      if (!usr || usr.role === 'viewer' || have[u]) return;
+      var payEmp = (typeof Payroll !== 'undefined' && Payroll.getEmployee) ? Payroll.getEmployee(u) : null;
+      _data().employees.push({
+        id: newId(),
+        name: usr.name || u,
+        username: u,
+        hourlyRate: (payEmp && Number(payEmp.hourlyRate)) || 0,
+        travelDefault: 0,
+        active: true,
+        note: ''
+      });
+      added++;
+    });
+    return added;
+  }
+
+  // ── auto-fill from the time clock ──
+  // Deliberately a copy of hours-report.js's tiering rather than a call into
+  // it: that module keeps its aggregation private, and duplicating ~30 lines
+  // is cheaper than exporting internals from a screen that is already shipped
+  // and working. If the contract rules ever change, they change in payroll.js
+  // (the single source) and both screens follow.
+  function contractFor(username) {
+    if (typeof Payroll !== 'undefined' && Payroll.getContract) return Payroll.getContract(username);
+    return { breakMin: 45, weeklyCapRegular: 2520, tier125Min: 120, tier150Min: 120 };
+  }
+
+  function recMin(r) {
+    if (r.duration) return Math.round(r.duration / 60000);
+    if (r.punchIn && r.punchOut) return Math.round((r.punchOut - r.punchIn) / 60000);
+    return 0;
+  }
+
+  function weekKey(dt) {
+    var d = new Date(dt.getTime());
+    d.setDate(d.getDate() - d.getDay());   // Sunday-start, Israeli work week
+    return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
+  }
+
+  function monthBounds() {
+    var start = state.year + '-' + pad(state.month + 1) + '-01';
+    var lastDay = new Date(state.year, state.month + 1, 0).getDate();
+    return { start: start, end: state.year + '-' + pad(state.month + 1) + '-' + pad(lastDay) };
+  }
+
+  function fetchMonth() {
+    var b = monthBounds();
+    var out = { records: [], events: {} };
+    if (typeof db === 'undefined') return Promise.resolve(out);
+
+    var jobs = [
+      db.collection('timeclock')
+        .where('date', '>=', b.start).where('date', '<=', b.end).get()
+        .then(function(snap) {
+          snap.forEach(function(doc) { out.records.push(Object.assign({ _id: doc.id }, doc.data())); });
+        })['catch'](function(err) {
+          console.warn('PayslipForm timeclock load failed:', err && err.message);
+        }),
+      db.collection('attendance-events')
+        .where('date', '>=', b.start).where('date', '<=', b.end).get()
+        .then(function(snap) {
+          snap.forEach(function(doc) {
+            var e = doc.data();
+            if (!e || !e.username || !e.date) return;
+            if (!out.events[e.username]) out.events[e.username] = {};
+            out.events[e.username][e.date] = e.event || '';
+          });
+        })['catch'](function() {})
+    ];
+    return Promise.all(jobs).then(function() { return out; });
+  }
+
+  // Returns { username -> { days, reg, t125, t150, vacation, sick, holiday } }
+  // Hours are decimal; day counters are whole days.
+  function aggregate(raw) {
+    var days = {};
+    raw.records.forEach(function(r) {
+      if (!r || !r.username || !r.date) return;
+      var k = r.username + '|' + r.date;
+      if (!days[k]) days[k] = { username: r.username, date: r.date, gross: 0 };
+      days[k].gross += recMin(r);
+    });
+
+    var perWorker = {};
+    Object.keys(days).forEach(function(k) {
+      var d = days[k];
+      var c = contractFor(d.username);
+      d.net = Math.max(0, d.gross - (d.gross > 0 ? (c.breakMin || 0) : 0));
+      if (!perWorker[d.username]) perWorker[d.username] = [];
+      perWorker[d.username].push(d);
+    });
+
+    var out = {};
+    Object.keys(perWorker).forEach(function(u) {
+      var c = contractFor(u);
+      var weeks = {};
+      var dayCount = 0;
+      perWorker[u].forEach(function(d) {
+        if (d.net > 0) dayCount++;
+        weeks[weekKey(new Date(d.date + 'T00:00:00'))] = (weeks[weekKey(new Date(d.date + 'T00:00:00'))] || 0) + d.net;
+      });
+      var reg = 0, t125 = 0, t150 = 0;
+      Object.keys(weeks).forEach(function(w) {
+        var rem = weeks[w];
+        var r = Math.min(rem, c.weeklyCapRegular || 2520); reg += r; rem -= r;
+        var a = Math.min(rem, c.tier125Min || 120); t125 += a; rem -= a;
+        if (rem > 0) t150 += rem;
+      });
+      out[u] = {
+        days: dayCount,
+        reg: reg / 60, t125: t125 / 60, t150: t150 / 60,
+        vacation: 0, sick: 0, holiday: 0
+      };
+    });
+
+    // Paid absence days come from attendance-events, not from punches.
+    Object.keys(raw.events).forEach(function(u) {
+      if (!out[u]) out[u] = { days: 0, reg: 0, t125: 0, t150: 0, vacation: 0, sick: 0, holiday: 0 };
+      var byDate = raw.events[u];
+      Object.keys(byDate).forEach(function(dt) {
+        var code = byDate[dt];
+        if (code === 'vacation' || code === 'personal') out[u].vacation++;
+        else if (code === 'sick' || code === 'accident') out[u].sick++;
+        else if (code === 'holiday') out[u].holiday++;
+      });
+    });
+
+    return out;
+  }
+
+  function _autofill() {
+    if (state.autofilling) return;
+    state.autofilling = true;
+    render();
+    fetchMonth().then(function(raw) {
+      var agg = aggregate(raw);
+      var touched = 0, skipped = 0;
+
+      activeEmployees().forEach(function(emp) {
+        if (!emp.username) return;
+        var a = agg[emp.username];
+        if (!a) return;
+        var r = row(emp.id);
+        ['days', 'reg', 't125', 't150', 'vacation', 'sick', 'holiday'].forEach(function(f) {
+          if (r.manual[f]) { skipped++; return; }      // hand-edited — never clobber
+          r[f] = Math.round(a[f] * 100) / 100;
+        });
+        if (!r.manual.rate) {
+          var payEmp = (typeof Payroll !== 'undefined' && Payroll.getEmployee) ? Payroll.getEmployee(emp.username) : null;
+          var rate = (payEmp && Number(payEmp.hourlyRate)) || emp.hourlyRate || 0;
+          if (rate) r.rate = rate;
+        }
+        touched++;
+      });
+
+      month(monthKey()).updatedAt = Date.now();
+      save();
+      state.autofilling = false;
+      render();
+      toast('🔄 ' + touched + ' ' + tt('עובדים עודכנו','พนักงานอัปเดต','موظفين محدّثين') +
+            (skipped ? ' · ' + skipped + ' ' + tt('שדות ידניים נשמרו','ช่องที่แก้ด้วยมือถูกเก็บไว้','حقول يدوية محفوظة') : ''));
+    })['catch'](function(err) {
+      state.autofilling = false;
+      render();
+      console.error('[PayslipForm autofill]', err);
+      toast('❌ ' + tt('שגיאה במשיכת נתוני שעון','ดึงข้อมูลไม่สำเร็จ','فشل جلب البيانات'));
+    });
+  }
+
+  // ── totals & estimate ──
+  function rowGross(r) {
+    var rate = Number(r.rate) || 0;
+    return (Number(r.reg) || 0) * rate
+         + (Number(r.t125) || 0) * rate * 1.25
+         + (Number(r.t150) || 0) * rate * 1.5;
+  }
+
+  function totals() {
+    var t = {};
+    COLS.forEach(function(c) { if (c.sum) t[c.k] = 0; });
+    t._gross = 0;
+    activeEmployees().forEach(function(emp) {
+      var r = row(emp.id);
+      COLS.forEach(function(c) { if (c.sum) t[c.k] += Number(r[c.k]) || 0; });
+      t._gross += rowGross(r);
+    });
+    return t;
+  }
+
+  // ── render ──
+  function show() {
+    if (!isAdminRole()) {
+      toast('⛔ ' + tt('למנהל מערכת בלבד','สำหรับผู้ดูแลระบบเท่านั้น','للمسؤول فقط'));
+      return;
+    }
+    var now = new Date();
+    if (!state.year) {
+      // Default to the month you are actually reporting: the previous one,
+      // since the form is filled in the first days of the following month.
+      var prev = new Date(now.getFullYear(), now.getMonth() - 1, 1);
+      state.year = prev.getFullYear();
+      state.month = prev.getMonth();
+    }
+    state.view = 'sheet';
+    var warm = (typeof Payroll !== 'undefined' && Payroll.load) ? Payroll.load() : Promise.resolve();
