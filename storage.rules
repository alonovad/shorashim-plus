rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same identity model as firestore.rules: custom-claim role, phone
    // recovery sessions excluded.
    //
    // The transitional no-claim hatch is GONE, to match firestore.rules.
    // `role() == null || ...` meant every signed-in account with no role
    // claim — which was all of them before the backfill — counted as staff
    // and could upload to or delete from build-plans/. firestore.rules
    // closed its equivalent hatch (noRoleYet) when the backfill finished;
    // this file kept its own copy open and was the last way in.
    //
    // Uploading an engineer's drawing is an admin action and admin is
    // stamped, so nothing legitimate loses access. A brand-new account is
    // stamped by claimSelfFromProfile at first login, before it can reach
    // any screen that writes here.
    function signedIn() {
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider != 'phone';
    }
    function role() {
      return ('role' in request.auth.token) ? request.auth.token.role : null;
    }
    function staff() {
      return signedIn() && role() in ['admin', 'operator'];
    }

    // Engineer's drawings and professional documents, one folder per
    // construction project (build-plans/{projectId}/{fileId}__{name}).
    // Read by anyone signed in (a worker may need to see a sheet); written
    // and deleted by staff only. Images and PDFs, 30 MB ceiling.
    match /build-plans/{projectId}/{file} {
      allow read: if signedIn();
      allow delete: if staff();
      allow create, update: if staff() &&
        request.resource.size < 30 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
