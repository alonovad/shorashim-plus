rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      // Phone-provider sessions are temporary (SMS credential recovery
      // only) and must never read or write app data — recovery runs
      // through the recoverAccount Cloud Function (Admin SDK).
      return request.auth != null &&
             request.auth.token.firebase.sign_in_provider != 'phone';
    }
    function getRole() {
      // Users without a custom claim must read as null. An ABSENT claim is
      // not the same as null in rules: request.auth.token.role would be
      // undefined and `undefined == null` is false, so noRoleYet() never
      // fired and every claim-less user was denied. .get(key, default)
      // returns the default when the field is missing — this is the fix.
      return request.auth.token.get('role', null);
    }
    function isAdmin() {
      return isSignedIn() && getRole() == 'admin';
    }
    function isOperatorOrAbove() {
      return isSignedIn() && getRole() in ['admin', 'operator'];
    }
    function isWorkerOrAbove() {
      return isSignedIn() && getRole() in ['admin', 'operator', 'worker'];
    }
    // noRoleYet() removed. Every account now carries a real role claim,
    // stamped by backfillUserRoles (one-off migration), setUserRoleByEmail
    // (admin edits a user) or claimSelfFromProfile (worker/viewer first
    // login). Do NOT deploy this file until a backfill dry run reports
    // zero unstamped accounts that matter -- without the hatch, a
    // claim-less user is denied everything.
    // App stores `username` as the prefix of the user's email (everything
    // before '@'), via email.split('@')[0] WITHOUT lowercasing — so a
    // worker with an uppercase email local-part (e.g. Somchai@gmail.com)
    // gets username "Somchai". Compare both sides lowercased, by EQUALITY
    // against the email prefix. Equality (not matches) is deliberate:
    // injecting the username into a regex let a worker set username='.*'
    // to match any email and forge ownership. split('@')[0] is CEL-safe.
    function isOwn(usernameField) {
      return isSignedIn() && request.auth.token.email != null &&
             usernameField.lower() == request.auth.token.email.lower().split('@')[0];
    }

    // ── appData collection ──
    match /appData/{docId} {
      // Prices (shorashim-prices-YYYY) and operation costing
      // (shorashim-prices-ops) are commercial data: operator+ only, so a
      // worker cannot read what suppliers charge or what a crew costs.
      allow read: if isSignedIn() &&
                     ((!docId.matches('shorashim-prices-.*') && !docId.matches('shorashim-cashflow-.*') && !docId.matches('shorashim-shipments-.*')) || isOperatorOrAbove());

      // TEMPORARY (broad grant): any signed-in user may write
      // shorashim-users. The app writes the WHOLE users blob for ordinary
      // self-service actions (primary plot, email edit, leave balances),
      // so operator-only blocked workers. This unblocks all users now.
      // ⚠ RISK: a worker can overwrite the whole doc, including their own
      // role → admin. The UI gates role changes, but the rule no longer
      // does. Proper fix: split self-service fields (primary_plot_id,
      // email) into per-user docs so workers write only their own record,
      // then revert this to operator-only for identity/role.
      allow write: if isSignedIn() && docId == 'shorashim-users';

      // Other admin-only docs (settings, config, talgil)
      allow write: if isAdmin() && docId in [
        'shorashim-talgil-config',
        'shorashim-talgil-cache',
        'shorashim-apps-script-url',
        'shorashim-valve-plot-map',
        'shorashim-crop-types',
        'shorashim-maintenance',
        'shorashim-maintenance-access',
        'shorashim-payroll',
        // payslip-form.js — the accountant's monthly hours form (admin only)
        'shorashim-payslip-form',
        // map-region.js — which part of the world the map is locked to
        'shorashim-map-region'
      ];

      // Plots and farms (plotMapperSprayData) — Oct 2026 ownership rule:
      // only admin creates or deletes plots and farms. An operator still
      // writes this document (sprays, work-log lines, fertilizer given are
      // stored in it), but only while the number of plots and farms stays
      // exactly as it was. That also stops a device holding a stale copy
      // from wiping a plot admin has just added.
      allow write: if isAdmin() && docId == 'plotMapperSprayData';
      allow update: if isOperatorOrAbove() && docId == 'plotMapperSprayData' &&
                       request.resource.data.value.get('plots', []).size() == resource.data.value.get('plots', []).size() &&
                       request.resource.data.value.get('farms', []).size() == resource.data.value.get('farms', []).size();

      // Operator+: operational data
      allow write: if isOperatorOrAbove() && docId in [
        'shorashim-tasks',
        'shorashim-field-reports',
        'shorashim-pest-lists',
        'shorashim-custom-actions',
        'shorashim-custom-worker-groups',
        'shorashim-workers',
        'shorashim-manager-teams',
        'shorashim-receipts',
        'shorashim-suppliers',
        'shorashim-orders',
        'shorashim-build-projects',
        'shorashim-build-catalog',
        // timeclock.js saveWorkplaces() writes this; it was never
        // whitelisted, so every workplace edit has been silently denied in
        // production. Same class of failure as the payroll document.
        'shorashim-workplaces',
        // knowledge.js: shared library of guides, files and the pest gallery.
        'shorashim-knowledge',
        // plotregister.js — plot attributes read from tables/PDFs, applied
        // to hand-drawn polygons. Same tier as the plots themselves.
        'shorashim-plot-register',
        // agriplan.js — saved templates for a plan's prep notes (shared
        // across seasons); each template's author edits it (ownership.js).
        'shorashim-agri-prep-templates'
      ];

      // Operator+: one tracking journal per construction project
      // (shorashim-build-ledger-1788460496331, ...). Money in and out of a
      // job, so it is deliberately not readable-writable by workers.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-build-ledger-[0-9]+');

      // Operator+: one tracking journal per maintenance project
      // (shorashim-maint-journal-1788460496331, ...), opened once the job is
      // approved (maintjournal.js). Its own document per project for the
      // same 1 MB reason as the build ledger it replaces.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-maint-journal-[0-9]+');

      // Operator+: one document register per construction project
      // (shorashim-build-docs-1788460496331, ...): the engineer's drawings
      // uploaded to Storage and what the model read out of each. Same
      // per-project split as the ledger, for the same 1 MB reason.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-build-docs-[0-9]+');

      // Operator+: one pest-monitoring document per growing year
      // (shorashim-pest-monitor-2026, -2027, ...). Prefix match rather than a
      // literal list so a new season needs no rules deploy.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-pest-monitor-[0-9]{4}');

      // Operator+: one treatment-plan document per growing year
      // (shorashim-agri-plan-2026, -2027, ...). Same prefix trick as
      // pest monitoring above — a new season needs no rules deploy.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-agri-plan-[0-9]{4}');

      // Operator+: sorting / harvest results, one document per season
      // (shorashim-harvest-2026, ...). harvest.js — packing-house statements
      // per orchard. Same prefix trick: a new season needs no rules deploy.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-harvest-[0-9]{4}');

      // Operator+: shared product & price database, one document per year
      // (shorashim-prices-2026, ...). prices.js — fed by every farm's
      // document intake; read restricted to operator+ above.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-prices-[0-9]{4}');

      // Admin only: operation costing — budget per line, required output,
      // hourly rate per worker group (opcost.js).
      allow write: if isAdmin() && docId == 'shorashim-prices-ops';

      // Admin only: treatment-plan approvals, one document per growing year
      // (shorashim-agri-approvals-2026, ...). Kept apart from the plan
      // document above so an operator — who writes the plans — cannot write
      // an approval. Each approval signs one farm's rows; agriplan.js shows a
      // farm's part of a plan on its card only while that signature matches.
      allow write: if isAdmin() &&
                      docId.matches('shorashim-agri-approvals-[0-9]{4}');

      // Operator+: cash-flow sheet per year (cashflow.js) — financial, so
      // also read-restricted to operator+ above.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-cashflow-[0-9]{4}');

      // Operator+: fruit shipments, packhouse intake, crates and the
      // cash-flow stage of sorting results (shipments.js) — commercial, so
      // also read-restricted to operator+ above.
      allow write: if isOperatorOrAbove() &&
                      docId.matches('shorashim-shipments-[0-9]{4}');

      // Worker+: plot recommendations and their follow-up (plotrec.js) —
      // tasks are marked done in the field; coefficients and imported
      // sources are edited by operator+ in the UI.
      allow write: if isWorkerOrAbove() && docId == 'shorashim-plotrec';

      // Worker+: red palm weevil traps and their counts, one doc per year
      // (traps.js). Whoever checks the traps in the field enters the counts.
      allow write: if isWorkerOrAbove() &&
                      docId.matches('shorashim-traps-[0-9]{4}');

      // Operator+: Sentinel-2 vegetation index per plot, one doc per farm
      // (satellite.js), and the per-farm pixel images (…-img-<farmId>). Written
      // after the operator pulls fresh data through sentinelNdvi /
      // sentinelImage; every signed-in role reads them.
      allow write: if isOperatorOrAbove() &&
                      (docId.matches('shorashim-sentinel-[0-9]+') ||
                       docId.matches('shorashim-sentinel-img-[0-9]+'));

      // Worker+: worklogs
      allow write: if isWorkerOrAbove() && docId.matches('shorashim-worklog.*');

      // Worker+: shared maintenance calendar. Any role granted maintenance
      // access (or admin) edits events; the UI enforces the access-map gate.
      // Worker+ tier avoids silent write failures for access-granted workers.
      allow write: if isWorkerOrAbove() && docId == 'shorashim-maintenance-schedule';
    }

    // ── timeclock collection ──
    match /timeclock/{recordId} {
      allow read: if isSignedIn();

      // Workers create their own records
      allow create: if isWorkerOrAbove();

      // Workers update their own records (Phase 1+ enforces username
      // matches the prefix of the auth email). Admin bypasses isOwn
      // because their username field may be manually set (e.g. 'admin')
      // and not match their email prefix.
      allow update: if isAdmin() ||
                       (isWorkerOrAbove() &&
                        isOwn(resource.data.username));

      // Operator+ can edit/delete any record (force-approve, fix mistakes)
      allow update, delete: if isOperatorOrAbove();
    }

    // ── audit-log collection (Phase 1) ──
    // Workers create their own audit entries (for actions like leave
    // submit) — the actor field must match their identity to prevent
    // forgery. Operator+ can create any entry. Admin reads.
    // Admin bypasses isOwn — see comment on timeclock rule.
    match /audit-log/{entryId} {
      allow read:   if isAdmin();
      allow create: if isOperatorOrAbove() ||
                       (isWorkerOrAbove() && isOwn(request.resource.data.actor)) ||
                       isAdmin();
      allow update, delete: if false;
    }

    // ── leave-requests collection (Phase 4) ──
    match /leave-requests/{requestId} {
      allow read: if isSignedIn();

      // Worker creates own request. Gate on role tier (worker+) ONLY —
      // identical to the timeclock create rule, which works. We dropped the
      // isOwn(token.email) ownership check that was here: an absent or
      // mismatched email claim made it return false and denied every leave
      // write (while timeclock, lacking the check, kept working). The app
      // always sets username to the logged-in user. Viewer stays blocked
      // (not worker+), and the UI hides leave from viewers anyway.
      allow create: if isWorkerOrAbove();

      // Operator+ approves/rejects
      allow update: if isOperatorOrAbove();

      // Worker cancels their own still-pending request — only the
      // status field may change (no sneaking other edits in).
      // Admin can cancel any.
      allow update: if isAdmin() ||
                    (isWorkerOrAbove() &&
                     isOwn(resource.data.username) &&
                     resource.data.status == 'pending' &&
                     request.resource.data.status == 'cancelled' &&
                     request.resource.data.diff(resource.data)
                       .affectedKeys().hasOnly(['status']));

      allow delete: if false;
    }

    // ── holidays collection (Phase 4) ──
    match /holidays/{year} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── presence collection (who currently has the app open) ──
    // Doc id == username. Any signed-in user heartbeats ONLY their own doc
    // (username must match their email prefix); admin bypasses. All roles
    // (incl. viewer) may appear as connected. Read by the dashboard.
    match /presence/{uname} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && isOwn(uname));
    }

    // ── attendance-events (אירוע per worker/day for the monthly report) ──
    // Any signed-in user may read (workers see their own report); only
    // operator/admin may write. Doc id = username__YYYY-MM-DD.
    match /attendance-events/{docId} {
      allow read: if isSignedIn();
      allow write: if isOperatorOrAbove();
    }

    // ── comments (comments.js, Oct 2026) ──
    // One document per comment, so authorship is checked here: anyone signed
    // in (viewer included) may comment as themselves; only the author edits;
    // the author or admin deletes.
    match /comments/{cid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.key is string && request.resource.data.key.size() <= 100 &&
                       request.resource.data.text is string && request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 2000;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid &&
                       request.resource.data.uid == resource.data.uid &&
                       request.resource.data.key == resource.data.key &&
                       request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
